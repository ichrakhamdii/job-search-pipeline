# Local dev: point this at a free Neon project's connection string (a "dev" branch/project),
# not a local Postgres install. Production points at a separate Neon "prod" branch/project.
# Format: postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# Celery broker/result backend. Upstash Redis free tier (serverless, no local install) works
# well here - same reasoning as using Neon for Postgres instead of a local install.
REDIS_URL=redis://localhost:6379/0
