# Copy this file to .env and fill in your own keys. Every key is optional except VOYAGE_API_KEY
# and GROQ_API_KEY are recommended for full functionality - the pipeline degrades gracefully
# (falls back to TF-IDF, skips the LLM judge, skips a source) for anything left blank.

# Voyage AI - semantic embeddings for stage-1 matching. Free tier: https://dashboard.voyageai.com
VOYAGE_API_KEY=

# Groq - free, open-weight LLM used as the stage-2 judge. Get a key: https://console.groq.com
GROQ_API_KEY=

# Adzuna - real job-search API, much larger pool than the keyless sources. Free key:
# https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Greenhouse / Lever - no API key needed, just the company board slugs you want to track
# (comma-separated). Find a company's slug from its careers page URL, e.g.
# boards.greenhouse.io/<slug> or jobs.lever.co/<slug>.
GREENHOUSE_COMPANIES=
LEVER_COMPANIES=
